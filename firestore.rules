rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // vocabulary collection — public read, authenticated write
    // -----------------------------------------------------------------------
    match /vocabulary/{wordId} {
      // Anyone can read vocabulary (public dictionary)
      allow read: if true;

      // Only authenticated admin users can create, update, or delete words
      allow write: if request.auth != null;
    }

    // -----------------------------------------------------------------------
    // All other collections — deny everything by default
    // -----------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
